# Read scan settings from GUI
function scan_parameters() #reads and converts GUI values from strings to floats
    holdTime = @>> get_gtk_property(gui["Hold"], :text, String) parse(Float64)          #hold durations
    scanTime = @>> get_gtk_property(gui["Scant"], :text, String) parse(Float64)         #scan duration
    flushTime = @>> get_gtk_property(gui["Flush"], :text, String) parse(Float64)        #flush duration
    startVoltage = @>> get_gtk_property(gui["StartV"], :text, String) parse(Float64)    #starting voltage for scan
    endVoltage = @>> get_gtk_property(gui["EndV"], :text, String) parse(Float64)        #ending voltage for scan
    scanLength = holdTime + scanTime + flushTime                                        #total scan cycle time  
    c = log(endVoltage / startVoltage) / (scanTime)                                     #exponential ramp rate constant for voltage sweep
    return holdTime, scanTime, flushTime, scanLength, startVoltage, endVoltage, c
